# Copie este arquivo para ".streamlit/secrets.toml" (SEM o .example) e
# preencha com suas credenciais reais. O arquivo "secrets.toml" já está no
# .gitignore — nunca commite suas chaves de verdade.

[turso]
# Mesmo banco Turso compartilhado que você já usa nos outros apps.
# Aceita tanto "libsql://..." quanto "https://...".
database_url = "libsql://SEU-BANCO-SEU-ORG.turso.io"
auth_token = "SEU_TOKEN_TURSO"

[auth]
# Login do admin — mesmo padrão dos seus outros apps (auth/auth_manager.py):
# NUNCA fica no Turso. Gere estas duas linhas com:
#   python scripts/create_admin_user.py
# Se você deixar esta seção fora (ou incompleta), o app cai automaticamente
# para o arquivo local auth/users.yaml, que o mesmo script também gera.
username = "admin"
password_hash = "$2b$12$SUBSTITUA_PELO_HASH_GERADO_PELO_SCRIPT"

# --- IA: escolha UM dos dois modos abaixo. ---------------------------
#
# MODO 1 (recomendado, mesmo padrão dos seus outros apps): preencha
# [n8n].webhook_url. Nesse caso o app manda o prompt pronto para o SEU
# n8n (importe "n8n/study_assistant_ai_cascade.json" lá) e é o próprio
# n8n quem decide a cascata Gemini -> Groq -> Groq 2 -> Mistral ->
# OpenAI -> Groq 3 e o fallback entre eles — igual ao workflow
# "Doc_QA_Generation_HA" que você já usa. Toda a seção [ai.*] abaixo é ignorada nesse modo, e
# você ganha de graça a aba "Executions" do n8n para ver o que
# aconteceu em cada tentativa (qual IA pegou, quando, se deu erro).
#
# MODO 2 (sem n8n): deixe [n8n].webhook_url vazio/fora e preencha as
# seções [ai.*] abaixo com suas chaves de API — nesse caso o próprio
# Python chama cada provedor direto e faz o fallback internamente.

[n8n]
# Cole aqui a URL do webhook depois de importar e ativar o workflow
# "n8n/study_assistant_ai_cascade.json" na sua instância n8n.
webhook_url = ""
# Opcional: mesmo padrão de Header Auth que você já usa nos outros
# webhooks (o workflow importado já vem configurado para exigir um
# header auth — "Header Auth account 5" — então preencha aqui o mesmo
# nome/valor de header que essa credencial espera).
auth_header_name = ""
auth_header_value = ""

# --- Cascata de provedores de IA (nessa ordem: openai -> gemini -> ---
# --- groq_primary -> groq_secondary -> mistral), espelhando o fluxo  ---
# --- em cascata que você já usa no n8n. Só é usada quando            ---
# --- [n8n].webhook_url (acima) está VAZIO. Deixe uma seção fora (ou  ---
# --- sem api_key) para pular esse provedor — o app só usa os que     ---
# --- tiverem chave configurada.                                      ---

[ai.openai]
api_key = "sk-..."
model = "gpt-5.5"

[ai.gemini]
api_key = "AI..."
model = "gemini-2.5-flash"

[ai.groq_primary]
api_key = "gsk_..."
model = "openai/gpt-oss-120b"

[ai.groq_secondary]
# Segunda conta/chave do Groq — mesmo padrão do seu fluxo em n8n
# (tenta de novo em outra conta antes de cair para o Mistral).
api_key = "gsk_..."
model = "openai/gpt-oss-120b"

[ai.mistral]
api_key = "..."
model = "mistral-large-latest"

[analysis]
# Análise em lotes (pra caber na cota por minuto das IAs gratuitas).
# Todos opcionais — os valores abaixo já são o padrão.
# Limite de texto analisado por rodada, somando todos os materiais.
max_total_chars = 200000
# Tamanho de cada lote enviado à IA.
batch_chars = 12000
# Por quantos dias as respostas da IA ficam salvas no Turso pra continuar
# uma análise pausada sem pedir de novo o que já foi respondido.
saved_responses_days = 7

[security]
bcrypt_rounds = 12
max_login_attempts = 5
lock_minutes = 15
